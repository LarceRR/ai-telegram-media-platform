# Copy to .env and adjust. Docker Compose reads this file too, so the POSTGRES_*
# and MINIO_* values below are what the local containers are created with.
# Never commit a real .env.

# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=15000

# ---- API ----
API_PORT=3001
API_GLOBAL_PREFIX=api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Local container credentials (used by docker-compose) ----
POSTGRES_USER=atmp
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=atmp
MINIO_ROOT_USER=atmp-local
MINIO_ROOT_PASSWORD=change-me-locally

# ---- PostgreSQL (pgvector) ----
DATABASE_URL=postgresql://atmp:change-me-locally@localhost:5432/atmp?schema=public

# ---- Redis / BullMQ ----
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=5

# ---- OpenRouter ----
# Leave empty for local fake-provider flows. Never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3001
OPENROUTER_APP_NAME=ai-telegram-media-platform

# ---- S3-compatible object storage ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=atmp-local
S3_ACCESS_KEY_ID=atmp-local
S3_SECRET_ACCESS_KEY=change-me-locally
S3_FORCE_PATH_STYLE=true

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# ---- Reserved for later milestones ----
# TELEGRAM_BOT_TOKEN=
