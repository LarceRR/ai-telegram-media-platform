generator client {
  provider = "prisma-client-js"
  output = "../packages/database/generated/client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  extensions = [vector]
}

enum AuditActorType { HUMAN SYSTEM AI }
enum UserStatus { ACTIVE DISABLED }
enum ChannelMode { MODERATED AUTO }
enum ChannelStatus { ACTIVE PAUSED ARCHIVED }
enum ChannelMemberRole { OWNER EDITOR OPERATOR VIEWER }
enum CredentialProvider { TELEGRAM_BOT }
enum SourceType { RSS WEB }
enum SourceStatus { ACTIVE PAUSED DISABLED }
enum SourceHealthStatus { HEALTHY DEGRADED FAILED }
enum ContentIdeaStatus { DISCOVERED ANALYZING CANDIDATE WAITING_FOR_EVIDENCE APPROVED PUBLISHED REJECTED ARCHIVED }
enum StoryStatus { ACTIVE ARCHIVED }
enum StoryRelationType { RELATED UPDATE CONTINUATION DUPLICATE }
enum MatchMethod { RULE VECTOR LLM HUMAN }
enum MemoryDecision { NEW RELATED UPDATE DUPLICATE }
enum MemoryItemKind { SOURCE_ITEM IDEA STORY PUBLICATION }
enum MemoryItemState { ACTIVE PENDING ARCHIVED }

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  displayName String @map("display_name")
  status UserStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  memberships ChannelMember[]
  createdChannels Channel[] @relation("channel_creator")
  credentialRefs SourceCredentialRef[]
  @@index([status])
  @@map("users")
}
model Channel {
  id String @id @default(uuid()) @db.Uuid
  telegramId String @unique @map("telegram_id")
  username String?
  title String
  language String @default("en")
  status ChannelStatus @default(ACTIVE)
  createdById String @map("created_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  settings ChannelSettings?
  members ChannelMember[]
  createdBy User @relation("channel_creator", fields: [createdById], references: [id], onDelete: Restrict)
  credential SourceCredentialRef?
  sources ChannelSource[]
  ideas ContentIdea[]
  stories Story[]
  memoryItems MemoryItem[]
  memoryDecisions MemoryDecisionLog[]
  @@index([status, createdAt])
  @@map("channels")
}
model ChannelSettings {
  id String @id @default(uuid()) @db.Uuid
  channelId String @unique @map("channel_id") @db.Uuid
  mode ChannelMode @default(MODERATED)
  timezone String @default("UTC")
  minInterest Int @default(6) @map("min_interest")
  minQuality Int @default(6) @map("min_quality")
  minEvidence Int @default(7) @map("min_evidence")
  minOriginality Int @default(5) @map("min_originality")
  researchMaxLevel Int @default(2) @map("research_max_level")
  minLength Int? @map("min_length")
  maxLength Int? @map("max_length")
  emojiEnabled Boolean @default(false) @map("emoji_enabled")
  forbiddenTopics Json @default("[]") @map("forbidden_topics")
  legalRestrictions Json @default("[]") @map("legal_restrictions")
  blacklist Json @default("[]")
  sourcePriorities Json @default("{}") @map("source_priorities")
  styleConfig Json @default("{}") @map("style_config")
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  @@map("channel_settings")
}
model ChannelMember {
  id String @id @default(uuid()) @db.Uuid
  channelId String @map("channel_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  role ChannelMemberRole
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([channelId, userId])
  @@index([userId, role])
  @@map("channel_members")
}
model SourceCredentialRef {
  id String @id @default(uuid()) @db.Uuid
  provider CredentialProvider
  secretRef String @map("secret_ref")
  channelId String? @unique @map("channel_id") @db.Uuid
  createdById String @map("created_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  channel Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  @@index([provider])
  @@map("source_credential_refs")
}
model Source {
  id String @id @default(uuid()) @db.Uuid
  name String
  type SourceType
  url String
  status SourceStatus @default(ACTIVE)
  categories String[] @default([])
  config Json @default("{}")
  lastCursor String? @map("last_cursor")
  lastIngestedAt DateTime? @map("last_ingested_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  channels ChannelSource[]
  items SourceItem[]
  healthSnapshots SourceHealthSnapshot[]
  @@unique([type, url])
  @@index([status, updatedAt])
  @@map("sources")
}
model ChannelSource {
  id String @id @default(uuid()) @db.Uuid
  channelId String @map("channel_id") @db.Uuid
  sourceId String @map("source_id") @db.Uuid
  priority Int @default(0)
  enabled Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  @@unique([channelId, sourceId])
  @@index([channelId, enabled, priority])
  @@map("channel_sources")
}
model SourceItem {
  id String @id @default(uuid()) @db.Uuid
  sourceId String @map("source_id") @db.Uuid
  externalItemId String @map("external_item_id")
  canonicalUrl String @map("canonical_url")
  contentHash String @map("content_hash")
  title String
  author String?
  publishedAt DateTime? @map("published_at")
  text String
  normalizedText String @map("normalized_text")
  metadata Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  source Source @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  images SourceImage[]
  imageCandidates ImageCandidate[]
  ideas ContentIdea[]
  storyLinks StorySourceItem[]
  @@unique([sourceId, externalItemId])
  @@unique([sourceId, contentHash])
  @@index([sourceId, publishedAt])
  @@index([contentHash])
  @@map("source_items")
}
model SourceImage {
  id String @id @default(uuid()) @db.Uuid
  sourceItemId String @map("source_item_id") @db.Uuid
  url String
  alt String?
  createdAt DateTime @default(now()) @map("created_at")
  sourceItem SourceItem @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)
  imageCandidate ImageCandidate?
  @@unique([sourceItemId, url])
  @@map("source_images")
}
model SourceHealthSnapshot {
  id String @id @default(uuid()) @db.Uuid
  sourceId String @map("source_id") @db.Uuid
  status SourceHealthStatus
  latencyMs Int? @map("latency_ms")
  httpStatus Int? @map("http_status")
  errorCategory String? @map("error_category")
  errorMessage String? @map("error_message")
  checkedAt DateTime @default(now()) @map("checked_at")
  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  @@index([sourceId, checkedAt])
  @@map("source_health_snapshots")
}
model ContentIdea {
  id String @id @default(uuid()) @db.Uuid
  channelId String @map("channel_id") @db.Uuid
  sourceItemId String @map("source_item_id") @db.Uuid
  storyId String? @map("story_id") @db.Uuid
  status ContentIdeaStatus @default(DISCOVERED)
  title String
  summary String
  normalizedText String @map("normalized_text")
  contentHash String @map("content_hash")
  canonicalUrl String @map("canonical_url")
  entities String[] @default([])
  topics String[] @default([])
  rank Int @default(0)
  decision MemoryDecision @default(NEW)
  decisionMethod MatchMethod @default(RULE) @map("decision_method")
  decisionConfidence Float @default(0) @map("decision_confidence")
  decisionExplanation String? @map("decision_explanation")
  rejectionReason String? @map("rejection_reason")
  classifiedAt DateTime? @map("classified_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sourceItem SourceItem @relation(fields: [sourceItemId], references: [id], onDelete: Restrict)
  story Story? @relation(fields: [storyId], references: [id], onDelete: SetNull)
  decisions MemoryDecisionLog[]
  @@unique([channelId, sourceItemId])
  @@index([channelId, status, createdAt])
  @@index([channelId, contentHash])
  @@index([storyId])
  @@map("content_ideas")
}
model Story {
  id String @id @default(uuid()) @db.Uuid
  channelId String @map("channel_id") @db.Uuid
  status StoryStatus @default(ACTIVE)
  title String
  summary String
  entities String[] @default([])
  topics String[] @default([])
  itemCount Int @default(0) @map("item_count")
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  lastPublishedAt DateTime? @map("last_published_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  ideas ContentIdea[]
  sourceItems StorySourceItem[]
  outgoingRelations StoryRelation[] @relation("story_relation_from")
  incomingRelations StoryRelation[] @relation("story_relation_to")
  @@index([channelId, status, lastSeenAt])
  @@map("stories")
}
model StorySourceItem {
  id String @id @default(uuid()) @db.Uuid
  storyId String @map("story_id") @db.Uuid
  sourceItemId String @map("source_item_id") @db.Uuid
  addedAt DateTime @default(now()) @map("added_at")
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  sourceItem SourceItem @relation(fields: [sourceItemId], references: [id], onDelete: Restrict)
  @@unique([storyId, sourceItemId])
  @@index([sourceItemId])
  @@map("story_source_items")
}
model StoryRelation {
  id String @id @default(uuid()) @default(uuid()) @db.Uuid
  fromStoryId String @map("from_story_id") @db.Uuid
  toStoryId String @map("to_story_id") @db.Uuid
  type StoryRelationType
  method MatchMethod
  confidence Float
  evidence Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  fromStory Story @relation("story_relation_from", fields: [fromStoryId], references: [id], onDelete: Cascade)
  toStory Story @relation("story_relation_to", fields: [toStoryId], references: [id], onDelete: Cascade)
  @@unique([fromStoryId, toStoryId, type])
  @@index([toStoryId])
  @@map("story_relations")
}
model MemoryItem {
  id String @id @default(uuid()) @db.Uuid
  channelId String @map("channel_id") @db.Uuid
  kind MemoryItemKind
  state MemoryItemState @default(ACTIVE)
  refId String @map("ref_id") @db.Uuid
  title String
  normalizedText String @map("normalized_text")
  contentHash String @map("content_hash")
  canonicalUrl String? @map("canonical_url")
  entities String[] @default([])
  topics String[] @default([])
  embeddingModel String @map("embedding_model")
  embeddingDim Int @map("embedding_dim")
  embedding Unsupported("vector(1536)")?
  archivedAt DateTime? @map("archived_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  matchedBy MemoryDecisionLog[] @relation("memory_decision_match")
  @@unique([channelId, kind, refId])
  @@index([channelId, state, kind])
  @@index([channelId, contentHash])
  @@index([channelId, canonicalUrl])
  @@map("memory_items")
}
model MemoryDecisionLog {
  id String @id @default(uuid()) @db.Uuid
  channelId String @map("channel_id") @db.Uuid
  ideaId String? @map("idea_id") @db.Uuid
  decision MemoryDecision
  method MatchMethod
  confidence Float
  explanation String
  matchedMemoryItemId String? @map("matched_memory_item_id") @db.Uuid
  distance Float?
  entityOverlap Float? @map("entity_overlap")
  configVersion String @map("config_version")
  correlationId String? @map("correlation_id")
  createdAt DateTime @default(now()) @map("created_at")
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  idea ContentIdea? @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  matchedMemoryItem MemoryItem? @relation("memory_decision_match", fields: [matchedMemoryItemId], references: [id], onDelete: SetNull)
  @@index([channelId, createdAt])
  @@index([ideaId, createdAt])
  @@index([decision, createdAt])
  @@map("memory_decisions")
}
model EmbeddingIndexMetadata {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  model String
  dimensions Int
  distance String
  indexType String @map("index_type")
  notes String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("embedding_index_metadata")
}
model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  actorType AuditActorType @map("actor_type")
  actorId String? @map("actor_id")
  action String
  entityType String @map("entity_type")
  entityId String @map("entity_id")
  correlationId String? @map("correlation_id")
  metadata Json?
  createdAt DateTime @default(now()) @map("created_at")
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@index([correlationId])
  @@map("audit_log")
}
model VectorProbe {
  id String @id @default(uuid()) @db.Uuid
  label String
  embedding Unsupported("vector(1536)")?
  createdAt DateTime @default(now()) @map("created_at")
  @@map("vector_probe")
}
model ImageCandidate {
  id String @id @default(uuid()) @db.Uuid
  sourceItemId String @map("source_item_id") @db.Uuid
  sourceImageId String @unique @map("source_image_id") @db.Uuid
  url String
  alt String?
  width Int?
  height Int?
  mimeType String? @map("mime_type")
  validationStatus String @default("VALID") @map("validation_status")
  selectionScore Float @default(0) @map("selection_score")
  selectedAt DateTime? @map("selected_at")
  createdAt DateTime @default(now()) @map("created_at")
  sourceItem SourceItem @relation(fields: [sourceItemId], references: [id], onDelete: Restrict)
  sourceImage SourceImage @relation(fields: [sourceImageId], references: [id], onDelete: Restrict)
  @@index([sourceItemId, validationStatus])
  @@map("image_candidates")
}
